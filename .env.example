# EBBot public environment template (no secrets).
# Copy this file to .env, then uncomment ONLY the providers and settings you use.
# All API key placeholders below are intentionally blank.
#
# Example: manual local web UI; uncomment as needed.
# WEBUI_HOST=127.0.0.1
# SCHEDULE_ENABLED=false
# REPORT_LANGUAGE=tr
#
# Solana Meme Radar: read-only, manual scan only. Default is disabled.
# MEME_RADAR_LIVE_ENABLED=false
#
# SearXNG 实例地址
# GitHub Actions: Variables 优先, Secrets 回退 (fallback) for private self-hosted URLs.
# Use an actual URL in Variables or Secrets. No Secrets are embedded here.
# SEARXNG_BASE_URLS=https://searxng.example.invalid
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
SEARXNG_TIMEOUT_SECONDS=10
#
# AI provider channel examples: uncomment ONE channel and configure its keys.
# These commented examples are inert; never commit a real API key.

# --- modelflare ---
# LLM_CHANNELS=modelflare
# LLM_MODELFLARE_MODELS=
# LLM_MODELFLARE_API_KEY=
# LLM_MODELFLARE_BASE_URL=https://modelflare.dev/v1
# LLM_MODELFLARE_PROTOCOL=

