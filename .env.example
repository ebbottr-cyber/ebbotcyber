# EBBot configuration template — non-secret, intentionally non-operational.
# Copy to .env for local development and fill ONLY the channels you intend to use.
# Do NOT commit real keys, session cookies, broker passwords, or wallet private keys.
# An empty LLM_CHANNELS disables channel selection; these commented examples DO NOT enable providers.
# The separate archived 00-daily-analysis workflow stays DISABLED.

# SearXNG 实例地址
# GitHub Actions: Variables 优先, Secrets fallback for SEARXNG_BASE_URLS.
# Host URLs are configuration, not credentials; do not expose private hosts in public logs.
# If self-hosted SearXNG is unavailable, leave the URL empty.
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
SEARXNG_TIMEOUT_SECONDS=10

# Optional channel selection. Configure exactly one or a deliberate comma-separated group.
# Example channel values below mirror the actual frontend provider templates.
# API keys remain empty placeholders and MUST be supplied privately.

# modelflare (disabled template example)
# LLM_CHANNELS=modelflare
# LLM_MODELFLARE_PROTOCOL=
# LLM_MODELFLARE_BASE_URL=https://modelflare.dev/v1
# LLM_MODELFLARE_MODELS=
# LLM_MODELFLARE_API_KEY=

