# ebbotcyber — güvenli örnek ortam değişkenleri
# Bu dosya yalnızca örnek ayarlar içerir; gerçek anahtar, parola ve token içermez.
# Yerel kullanımda .env dosyasına kopyalayın, gerçek sırları sadece .env içine girin.
# .env ve .env.*.local dosyaları Git'e eklenmemelidir.

# Temel ayarlar (kayıtlı, gizli olmayan varsayılanlar)
STOCK_LIST=600519,300750,002594
GENERATION_BACKEND=litellm

# SearXNG 实例地址
# GitHub Actions: Variables 优先; Secrets gizli değerler için yedek kaynaktır.
# Arşivlenmiş günlük analiz iş akışı Variables değerini, yoksa Secrets değerini okur.
# Kendi SearXNG adresinizi yerel .env dosyanızda tanımlayın.
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
SEARXNG_TIMEOUT_SECONDS=10

# LLM sağlayıcıları — tüm örnekler yorum satırıdır, hiçbir kanal otomatik açılmaz.
# Bir kanal seçmek için yalnızca ilgili örneği yerel .env içinde etkinleştirin.
# API anahtarlarını bu örnek dosyaya asla yazmayın.

# modelflare (isteğe bağlı)
# LLM_CHANNELS=modelflare
# LLM_MODELFLARE_MODELS=
# LLM_MODELFLARE_API_KEY=
# LLM_MODELFLARE_BASE_URL=https://modelflare.dev/v1
# LLM_MODELFLARE_PROTOCOL=openai

# aihubmix (isteğe bağlı)
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_MODELS=
# LLM_AIHUBMIX_API_KEY=
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_PROTOCOL=openai

# deepseek (isteğe bağlı)
